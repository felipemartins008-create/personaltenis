{
  "version": 2,
  "rewrites": [
    { "source": "/c/:banner", "destination": "/api/c.js?banner=:banner" },
    { "source": "/c", "destination": "/api/c.js" },
    { "source": "/link/:banner", "destination": "/api/c.js?banner=:banner" },
    { "source": "/link", "destination": "/api/c.js" },
    { "source": "/divulgacao", "destination": "/divulgacao.html" },
    { "source": "/whatsapp", "destination": "/whatsapp.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/c/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }
      ]
    },
    {
      "source": "/c",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }
      ]
    }
  ]
}
